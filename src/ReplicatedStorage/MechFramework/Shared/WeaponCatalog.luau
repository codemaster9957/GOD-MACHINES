local ById: {[string]: WeaponRecord} = {}
for _, record in ipairs(Ordered) do
	assert(ById[record.Id] == nil, `Duplicate weapon id: {record.Id}`)
	ById[record.Id] = record
end

return table.freeze({
	Ordered = table.freeze(Ordered),
	ById = table.freeze(ById),
})
