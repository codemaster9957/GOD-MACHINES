--!strict
-- Single source of truth for original GOD MACHINES humanoid-mech weapons.

export type WeaponRecord = {
	Id: string,
	DisplayName: string,
	ShortName: string,
	DefaultAction: string,
	MountRole: string,
	Size: Vector3,
	Mass: number,
	MaxHealth: number,
	Power: {[string]: number},
	Heat: {[string]: number},
	Combat: {[string]: any},
	Collection: {[string]: any},
	Visual: {[string]: any},
}

local function weapon(record: WeaponRecord): WeaponRecord
	record.Combat.DefaultAction = record.DefaultAction
	return table.freeze(record)
end

